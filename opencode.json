{
  "$schema": "https://opencode.ai/config.json",
  "username": "Marcelo Frau",
  "model": "github-copilot/claude-haiku-4.5",
  "logLevel": "INFO",

  "instructions": [
    ".opencode/AGENTS.md",
    "docs/IMPLEMENTATION_PLAN.md",
    "docs/ARCHITECTURE.md"
  ],

  "lsp": {
    "csharp": {
      "command": ["csharp-ls"],
      "extensions": ["cs", "csproj", "sln", "slnx"]
    }
  },

  "permission": {
    "edit": "allow",
    "bash": { "git *": "allow", "dotnet *": "allow", "*": "ask" },
    "external_directory": "allow"
  },

  "agent": {
    "build": {
      "description": "Build, test, debug C# / Avalonia code. Fix compile errors, implement features, run tests.",
      "steps": 15
    }
  },

  "references": {
    "archive": {
      "path": "../archive",
      "description": "Prior switchcraft-keys implementations (Python, Rust) for reference and architecture patterns"
    }
  }
}
